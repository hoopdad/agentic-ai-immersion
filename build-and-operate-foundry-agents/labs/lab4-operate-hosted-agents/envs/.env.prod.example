# Lab 4: per-environment settings for the prod environment.
# Production shape. Redis message store, sensitive tracing OFF, deploy only from a tag through the pipeline, never from a laptop.
# Copy to envs/.env.prod for promote.py --execute and replace every placeholder with the target GitHub Environment
# "prod" variables (or let agent-ci.yml provide them). Nothing here is a secret: Entra-only auth, no API keys, ever.
# Variable names follow the base repo's .env.example; MARKETPLACE_ prefixed ones are workshop-specific.

FOUNDRY_PROJECT_ENDPOINT=
PROJECT_RESOURCE_ID=
TENANT_ID=
AZURE_OPENAI_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
FOUNDRY_MODEL=gpt-5.4-mini
EMBEDDING_MODEL_DEPLOYMENT_NAME=text-embedding-3-large
AZURE_AI_SEARCH_ENDPOINT=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Workshop-specific: the hosted agent reads these as container environment (azd env set)
MARKETPLACE_TODAY=2026-10-06
MARKETPLACE_KB_MCP_URL=
MARKETPLACE_REDIS_URL=<rediss://<name>.<region>.redis.azure.net:10000/0  Azure Managed Redis, Entra auth>
MARKETPLACE_SESSION_TTL_SECONDS=604800
ENABLE_SENSITIVE_DATA=false
