# Lab 5: per-environment settings for the dev environment.
# Developer sandbox. File message store, sensitive tracing allowed (synthetic data only), knowledge base from your own Lab 3 run.
# Copy to the workshop root .env for local development (or let agent-ci.yml do it) and fill the empty values from the GitHub
# Environment "dev" variables. Nothing here is a secret: Entra-only auth, no API keys, ever.
# Variable names follow the base repo's .env.example; MARKETPLACE_ prefixed ones are workshop-specific.

FOUNDRY_PROJECT_ENDPOINT=
PROJECT_RESOURCE_ID=
TENANT_ID=
AZURE_OPENAI_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
FOUNDRY_MODEL=gpt-5.4-mini
EMBEDDING_MODEL_DEPLOYMENT_NAME=text-embedding-3-large
AZURE_AI_SEARCH_ENDPOINT=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Workshop-specific: the hosted agent reads these as container environment (azd env set)
MARKETPLACE_TODAY=2026-10-06
MARKETPLACE_KB_MCP_URL=
MARKETPLACE_BLOB_STORAGE_URL=
MARKETPLACE_BLOB_STORAGE_CONTAINER=marketplace-history
MARKETPLACE_SESSION_TTL_SECONDS=604800
ENABLE_SENSITIVE_DATA=true
